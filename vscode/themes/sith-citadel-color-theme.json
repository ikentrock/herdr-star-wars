    "tab.activeForeground": "#eadede",
    "tab.activeBorderTop": "#ff2a3a",
    "tab.inactiveBackground": "#110809",
    "tab.inactiveForeground": "#8a6d70",
    "tab.hoverBackground": "#2a1215",
    "tab.border": "#3a181c",
    "tab.unfocusedActiveBorderTop": "#ff2a3a66",
    "tab.unfocusedActiveForeground": "#bfa3a6",
    "breadcrumb.foreground": "#bfa3a6",
    "breadcrumb.focusForeground": "#eadede",
