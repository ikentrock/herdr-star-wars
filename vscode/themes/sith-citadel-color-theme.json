    "tree.indentGuidesStroke": "#3a181c",
    "menu.background": "#1a0d10",
    "menu.foreground": "#eadede",
    "menu.selectionBackground": "#3a1218",
    "menu.selectionForeground": "#eadede",
    "menu.separatorBackground": "#3a181c",
    "menu.border": "#3a181c",
    "quickInput.background": "#1a0d10",
    "quickInput.foreground": "#eadede",
    "quickInputList.focusBackground": "#3a1218",
    "quickInputList.focusForeground": "#eadede",
    "pickerGroup.foreground": "#ff2a3a",
    "pickerGroup.border": "#3a181c",
    "editorWidget.background": "#1a0d10",
    "editorWidget.border": "#3a181c",
    "editorSuggestWidget.background": "#1a0d10",
    "editorSuggestWidget.border": "#3a181c",
    "editorSuggestWidget.selectedBackground": "#3a1218",
    "editorSuggestWidget.highlightForeground": "#ff2a3a",
    "editorHoverWidget.background": "#1a0d10",
    "editorHoverWidget.border": "#3a181c",
    "notifications.background": "#1a0d10",
    "notifications.border": "#3a181c",
    "notificationCenterHeader.background": "#110809",
    "notificationsErrorIcon.foreground": "#ff3344",
    "notificationsWarningIcon.foreground": "#ffb347",
    "notificationsInfoIcon.foreground": "#ff2a3a",
    "editor.background": "#0d0809",
    "editor.foreground": "#eadede",
    "editorCursor.foreground": "#ff2a3a",
    "editor.selectionBackground": "#4a1219",
    "editor.inactiveSelectionBackground": "#4a121999",
    "editor.selectionHighlightBackground": "#4a121980",
    "editor.wordHighlightBackground": "#4a121973",
    "editor.wordHighlightStrongBackground": "#4a1219b3",
    "editor.findMatchBackground": "#ffb34773",
    "editor.findMatchHighlightBackground": "#ffb34738",
    "editor.findMatchBorder": "#ffb347",
    "editor.lineHighlightBackground": "#140b0d",
    "editor.lineHighlightBorder": "#00000000",
    "editor.rangeHighlightBackground": "#ff2a3a14",
    "editorLineNumber.foreground": "#8a6d70",
    "editorLineNumber.activeForeground": "#ff2a3a",
    "editorIndentGuide.background1": "#3a181c99",
    "editorIndentGuide.activeBackground1": "#8a6d70",
    "editorWhitespace.foreground": "#8a6d7066",
    "editorRuler.foreground": "#3a181c",
    "editorBracketMatch.background": "#ff2a3a26",
    "editorBracketMatch.border": "#ff2a3a",
    "editorCodeLens.foreground": "#8a6d70",
    "editorLink.activeForeground": "#ff2a3a",
    "editorError.foreground": "#ff3344",
    "editorWarning.foreground": "#ffb347",
    "editorInfo.foreground": "#ff2a3a",
    "editorGutter.addedBackground": "#e8e0e0",
    "editorGutter.modifiedBackground": "#ff2a3a",
    "editorGutter.deletedBackground": "#ff3344",
    "editorOverviewRuler.border": "#3a181c",
    "editorOverviewRuler.errorForeground": "#ff3344",
    "editorOverviewRuler.warningForeground": "#ffb347",
    "editorOverviewRuler.findMatchForeground": "#ffb347",
    "scrollbarSlider.background": "#8a6d7059",
    "scrollbarSlider.hoverBackground": "#8a6d708c",
    "scrollbarSlider.activeBackground": "#ff2a3a99",
    "minimap.selectionHighlight": "#4a1219",
    "peekView.border": "#ff2a3a",
    "peekViewEditor.background": "#140b0d",
    "peekViewResult.background": "#1a0d10",
    "peekViewTitle.background": "#110809",
    "diffEditor.insertedTextBackground": "#7ccf7a38",
    "diffEditor.removedTextBackground": "#ff334438",
    "gitDecoration.addedResourceForeground": "#7ccf7a",
    "gitDecoration.untrackedResourceForeground": "#7ccf7a",
    "gitDecoration.modifiedResourceForeground": "#7d97ff",
    "gitDecoration.deletedResourceForeground": "#ff3344",
    "gitDecoration.conflictingResourceForeground": "#ffb347",
    "gitDecoration.ignoredResourceForeground": "#8a6d70",
    "merge.currentHeaderBackground": "#7ccf7a66",
    "merge.incomingHeaderBackground": "#7d97ff66",
    "terminal.background": "#0d0809",
    "terminal.foreground": "#eadede",
    "terminalCursor.foreground": "#ff2a3a",
    "terminal.selectionBackground": "#4a1219",
    "terminal.border": "#3a181c",
    "terminal.ansiBlack": "#2a1c1e",
    "terminal.ansiRed": "#ff3344",
    "terminal.ansiGreen": "#7ccf7a",
    "terminal.ansiYellow": "#ffb347",
    "terminal.ansiBlue": "#7d97ff",
    "terminal.ansiMagenta": "#d65cff",
    "terminal.ansiCyan": "#4fd6d6",
    "terminal.ansiWhite": "#cdbfc0",
    "terminal.ansiBrightBlack": "#7a6164",
    "terminal.ansiBrightRed": "#ff6670",
    "terminal.ansiBrightGreen": "#a3e89f",
    "terminal.ansiBrightYellow": "#ffd27a",
    "terminal.ansiBrightBlue": "#a6b8ff",
    "terminal.ansiBrightMagenta": "#e895ff",
    "terminal.ansiBrightCyan": "#8ef0f0",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8e7274",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#ff3344"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#bfa3a6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#7ccf7a"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff3344"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#ff6670"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#4fd6d6"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#ffb347"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d65cff"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#4fd6d6"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#eadede"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eadede",
        "fontStyle": "italic"
      }
    },
    {
      "name": "This and self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#ff3344",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#cdbfc0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ff6670"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ffd27a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#ffb347"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#ff3344"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#4fd6d6"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ff3344",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#eadede",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#eadede",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4fd6d6"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8e7274",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#ffb347"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7ccf7a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ff3344"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#ffb347"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff3344",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "variable.readonly": "#ffb347",
    "property.readonly": "#ffb347",
    "enumMember": "#ffb347",
    "parameter": {
      "foreground": "#eadede",
      "italic": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
