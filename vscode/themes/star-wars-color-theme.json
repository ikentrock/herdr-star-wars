    "statusBarItem.errorForeground": "#ffffff",
    "editorGroupHeader.tabsBackground": "#0e1119",
    "editorGroupHeader.tabsBorder": "#2a3246",
    "editorGroup.border": "#2a3246",
    "editorGroup.dropBackground": "#ffe81f26",
    "tab.activeBackground": "#0b0d14",
    "tab.activeForeground": "#d8dce6",
    "tab.activeBorderTop": "#ffe81f",
    "tab.inactiveBackground": "#0e1119",
    "tab.inactiveForeground": "#5d667a",
    "tab.hoverBackground": "#1e2536",
    "tab.border": "#2a3246",
    "tab.unfocusedActiveBorderTop": "#ffe81f66",
    "tab.unfocusedActiveForeground": "#9aa3b5",
    "breadcrumb.foreground": "#9aa3b5",
    "breadcrumb.focusForeground": "#d8dce6",
    "breadcrumb.activeSelectionForeground": "#ffe81f",
    "breadcrumbPicker.background": "#151a26",
    "list.hoverBackground": "#1e2536",
