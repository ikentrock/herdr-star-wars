{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    16,
    16
  ],
  "theme": "sith",
  "font": "JetBrains Mono",
  "font_size": 14,
  "ui_font": "Avenir Next",
  "terminal_padding": [
    10,
    8
  ],
  "background": {
    "gradient": [
      "#2a070c",
      "#050304"
    ],
    "angle": 160
  },
  "preview": "layouts/sith.svg",
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": {
        "px": 44
      },
      "window_drag": true,
      "content": {
        "mod": "starwars",
        "props": {
          "side": "sith",
          "role": "bar"
        }
      }
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "floating": [
        {
          "id": "droid",
          "content": {
            "mod": "starwars",
            "props": {
              "side": "sith",
              "role": "droid"
            }
          },
          "edge": "right",
          "align": "end"
        }
      ],
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 264
          },
          "min": 200,
          "max": 440,
          "content": {
            "mod": "starwars",
            "props": {
              "side": "sith",
              "role": "sidebar"
            }
          }
        },
        {
          "id": "main",
          "type": "block",
          "padding": 10,
          "content": {
            "tab": "active",
            "pane": {
              "gap": 10,
              "radius": 3,
              "background": "background",
              "lone": true,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "starwars",
                  "props": {
                    "side": "sith",
                    "role": "header"
                  }
                },
                "height": 36,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 26
      },
      "content": {
        "mod": "starwars",
        "props": {
          "side": "sith",
          "role": "status"
        }
      }
    }
  ]
}